  "beats": [
    {
      "id": "01",
      "title_internal": "Inquadratura d'insieme: da lontano",
      "wide": true,
      "focus": [
        0.5,
        0.5
      ],
      "zoom_start": 1.0,
      "zoom_end": 1.02,
      "speech": "Da lontano sembra una festa di paese: una piazza, un fiume, gente che lavora. Da vicino, oltre cento proverbi: la follia umana in un solo quadro."
    },
    {
      "id": "02",
      "title_internal": "Il mondo sottosopra",
      "focus": [
        0.0616,
        0.432
      ],
      "zoom_start": 2.93,
      "zoom_end": 5.27,
      "speech": "Il mondo ruota capovolto, appeso a una casa: è il mondo alla rovescia, dove nulla è come dovrebbe essere."
    },
    {
      "id": "03",
      "title_internal": "I pazzi e le carte migliori",
      "focus": [
        0.0997,
        0.3291
      ],
      "zoom_start": 1.6,
      "zoom_end": 2.88,
      "speech": "E così il destino premia gli sciocchi: i pazzi hanno in mano le carte migliori."
    },
    {
      "id": "04",
      "title_internal": "Guardare tra le dita",
      "focus": [
        0.0778,
        0.2107
      ],
      "zoom_start": 3.23,
      "zoom_end": 5.82,
      "speech": "Chiudiamo un occhio sui torti che ci convengono, e guardiamo il mondo tra le dita."
    },
    {
      "id": "05",
      "title_internal": "Il coltello sulla porta",
      "focus": [
        0.0853,
        0.2527
      ],
      "zoom_start": 3.58,
      "zoom_end": 6.44,
      "speech": "Altri appendono il coltello sulla porta: chi cerca la lite, prima o poi la trova."
    },
    {
      "id": "06",
      "title_internal": "Gli zoccoli di chi aspetta invano",
      "focus": [
        0.125,
        0.2125
      ],
      "zoom_start": 2.64,
      "zoom_end": 4.76,
      "speech": "C'è chi lascia gli zoccoli davanti alla porta e aspetta invano: resta lì, per tutta la vita."
    },
    {
      "id": "07",
      "title_internal": "Come cadono le carte",
      "focus": [
        0.1663,
        0.4298
      ],
      "zoom_start": 2.17,
      "zoom_end": 3.9,
      "speech": "Per altri decide il caso: tutto dipende da come cadono le carte."
    },
    {
      "id": "08",
      "title_internal": "Due pazzi sotto un cappuccio",
      "focus": [
        0.4487,
        0.3344
      ],
      "zoom_start": 3.61,
      "zoom_end": 6.5,
      "speech": "Sotto un solo cappuccio stanno due pazzi: la stupidità non viaggia mai da sola."
    },
    {
      "id": "09",
      "title_internal": "Baciare l'anello alla porta",
      "focus": [
        0.5984,
        0.2482
      ],
      "zoom_start": 3.23,
      "zoom_end": 5.82,
      "speech": "E altri baciano l'anello alla porta, servili con chi comanda, pur di farsi notare."
    },
    {
      "id": "10",
      "title_internal": "Chi origlia dietro il muro",
      "focus": [
        0.2822,
        0.3746
      ],
      "zoom_start": 1.6,
      "zoom_end": 2.88,
      "speech": "Qualcuno origlia dietro il muro, convinto che nessuno lo veda."
    },
    {
      "id": "11",
      "title_internal": "Il sussurratore",
      "focus": [
        0.5219,
        0.5168
      ],
      "zoom_start": 2.39,
      "zoom_end": 4.31,
      "speech": "Poi la calunnia, sussurrata all'orecchio, piano, perché nessuno la senta."
    },
    {
      "id": "12",
      "title_internal": "Il piatto vuoto",
      "focus": [
        0.5781,
        0.5614
      ],
      "zoom_start": 3.61,
      "zoom_end": 6.5,
      "speech": "Che vale un piatto d'argento se è vuoto? Splendidi fuori, e vuoti dentro."
    },
    {
      "id": "13",
      "title_internal": "Il debito segnato col gesso",
      "focus": [
        0.6147,
        0.5137
      ],
      "zoom_start": 3.23,
      "zoom_end": 5.82,
      "speech": "E altri sono in debito, il conto segnato col gesso: basta poco, e tutto è perduto."
    },
    {
      "id": "14",
      "title_internal": "L'osso già spolpato",
      "focus": [
        0.2562,
        0.5658
      ],
      "zoom_start": 3.61,
      "zoom_end": 6.5,
      "speech": "C'è chi rosicchia un osso già spolpato: si ostina su ciò che non dà più nulla."
    },
    {
      "id": "15",
      "title_internal": "La testa contro il muro",
      "focus": [
        0.1734,
        0.8432
      ],
      "zoom_start": 1.6,
      "zoom_end": 2.88,
      "speech": "E chi sbatte la testa contro il muro: caparbio, spreca la vita contro ciò che non cede."
    },
    {
      "id": "16",
      "title_internal": "Chiudere il pozzo troppo tardi",
      "focus": [
        0.4959,
        0.8821
      ],
      "zoom_start": 1.0,
      "zoom_end": 1.75,
      "speech": "Chi copre il pozzo solo dopo che il vitello è annegato: capiamo tutto troppo tardi."
    },
    {
      "id": "17",
      "title_internal": "Il mondo sul pollice",
      "focus": [
        0.7069,
        0.8525
      ],
      "zoom_start": 1.32,
      "zoom_end": 2.38,
      "speech": "Qualcuno fa ballare il mondo sul pollice, convinto di guidare ciò che non capisce."
    },
    {
      "id": "18",
      "title_internal": "Nuotare contro corrente",
      "focus": [
        0.8888,
        0.3913
      ],
      "zoom_start": 2.17,
      "zoom_end": 3.9,
      "speech": "Ma uno nuota contro corrente, solo contro tutti: forse è l'unico modo di restare umani."
    },
    {
      "id": "19",
      "title_internal": "Chiusura: siamo ancora noi",
      "wide": true,
      "focus": [
        0.5,
        0.47
      ],
      "zoom_start": 1.0,
      "zoom_end": 1.02,
      "speech": "Quattro secoli dopo il mondo è ancora capovolto: quei proverbi siamo noi, siamo ancora noi."
    }
  ],
