  "beats": [
    {
      "id": "01",
      "title_internal": "Inquadratura d'insieme: da lontano",
      "wide": true,
      "focus": [0.5, 0.5],
      "zoom_start": 1.0,
      "zoom_end": 1.02,
      "speech": "Da lontano sembra una festa di paese. Da vicino è il ritratto di noi: oltre cento proverbi dipinti in un solo quadro."
    },
    {
      "id": "02",
      "title_internal": "Il mondo sottosopra",
      "focus": [0.062, 0.431],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "Tutto è sottosopra: il mondo ruota capovolto, come se la ragione avesse perso la testa."
    },
    {
      "id": "03",
      "title_internal": "I pazzi e le carte migliori",
      "focus": [0.1, 0.329],
      "zoom_start": 1.18,
      "zoom_end": 1.45,
      "speech": "E il destino premia gli sciocchi: i pazzi hanno in mano le carte migliori."
    },
    {
      "id": "04",
      "title_internal": "Guardare tra le dita",
      "focus": [0.077, 0.208],
      "zoom_start": 1.18,
      "zoom_end": 1.45,
      "speech": "Chiudiamo un occhio sui torti che ci convengono, e guardiamo il mondo tra le dita."
    },
    {
      "id": "05",
      "title_internal": "Due pazzi sotto un cappuccio",
      "focus": [0.448, 0.334],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "Sotto un solo cappuccio stanno due pazzi: la stupidità non viaggia mai da sola."
    },
    {
      "id": "06",
      "title_internal": "Baciare la mano al padrone",
      "focus": [0.598, 0.247],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "Altri baciano la mano a chi comanda, pronti a piegarsi pur di farsi notare."
    },
    {
      "id": "07",
      "title_internal": "Il sussurratore",
      "focus": [0.523, 0.518],
      "zoom_start": 1.18,
      "zoom_end": 1.44,
      "speech": "E poi la calunnia, sussurrata all'orecchio, piano, perché nessuno la senta."
    },
    {
      "id": "08",
      "title_internal": "Il piatto vuoto",
      "focus": [0.578, 0.562],
      "zoom_start": 1.18,
      "zoom_end": 1.44,
      "speech": "Che vale un piatto d'argento se è vuoto? Splendidi fuori, e vuoti dentro."
    },
    {
      "id": "09",
      "title_internal": "La testa contro il muro",
      "focus": [0.173, 0.844],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "C'è chi sbatte la testa contro il muro: ostinato, spreca la vita contro un ostacolo che non cede."
    },
    {
      "id": "10",
      "title_internal": "Chiudere il pozzo troppo tardi",
      "focus": [0.495, 0.882],
      "zoom_start": 1.16,
      "zoom_end": 1.43,
      "speech": "E chi chiude il pozzo solo dopo che il vitello è annegato: capiamo tutto troppo tardi."
    },
    {
      "id": "11",
      "title_internal": "Il mondo sul pollice",
      "focus": [0.707, 0.85],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "Qualcuno fa ballare il mondo sul pollice, convinto di guidare ciò che non capisce."
    },
    {
      "id": "12",
      "title_internal": "Nuotare contro corrente",
      "focus": [0.888, 0.39],
      "zoom_start": 1.15,
      "zoom_end": 1.42,
      "speech": "Ma uno nuota contro corrente, da solo contro tutti: forse è l'unico modo di restare umani."
    },
    {
      "id": "13",
      "title_internal": "La rastrelliera senza manico",
      "focus": [0.93, 0.884],
      "zoom_start": 1.18,
      "zoom_end": 1.45,
      "speech": "E noi siamo una rastrelliera senza manico: strumenti incompleti, testardi, inutili."
    },
    {
      "id": "14",
      "title_internal": "Chiusura: siamo ancora noi",
      "wide": true,
      "focus": [0.5, 0.47],
      "zoom_start": 1.0,
      "zoom_end": 1.02,
      "speech": "Quattro secoli dopo, questo quadro è ancora pieno di noi."
    }
  ],
